# Скопируйте этот файл в .env и подставьте свои значения.
# .env в git не коммитится (см. .gitignore), а .env.example — коммитится,
# чтобы любой разработчик знал, какие переменные нужны проекту.

# Секретный ключ Django. Сгенерировать новый можно командой:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-me

# True только для локальной разработки. В проде всегда False.
DJANGO_DEBUG=True

# Через запятую, без пробелов. Для локального запуска достаточно localhost.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
