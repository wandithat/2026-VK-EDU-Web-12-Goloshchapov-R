# Скопируйте в .env.local для локального запуска или в .env.docker для Docker Compose.
DJANGO_SECRET_KEY=change-me-generate-a-new-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.postgresql
DB_NAME=askroman
DB_USER=askroman
DB_PASSWORD=askroman_password
DB_HOST=localhost
DB_PORT=5432

# Параметры контейнера PostgreSQL (для Docker Compose).
POSTGRES_DB=askroman
POSTGRES_USER=askroman
POSTGRES_PASSWORD=askroman_password
